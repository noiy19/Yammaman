# =============================================================================
# Yammaman — environment template
# =============================================================================
#   cp .env.example .env
#
# .env is gitignored and must stay that way: tech-stack.md requires credentials
# and the live TenantApiKey to stay out of this repo.
#
# THE ONE RULE: VITE_ MEANS PUBLIC.
# Anything prefixed VITE_ is inlined into the browser bundle and is readable by
# anyone with devtools. It is for public identifiers only, never secrets.
# Secrets are unprefixed, are set in the deployment platform's server
# environment, and must never be imported by anything under src/.
#
# Full reasoning, and the variables deliberately not listed yet:
#   docs/environment.md
# =============================================================================

# ---- client-safe: compiled into the bundle, PUBLIC --------------------------

# Commerce engine (Pratap's OMS/CMS) base URL. Reached through a server-side
# proxy; the engine's own API key never reaches the browser.
# OPEN ITEM: pending the API rundown.
VITE_COMMERCE_API_BASE=

# Cloudinary cloud name. A PUBLIC identifier, not a secret — it is the host
# segment of every delivery URL. This is the only Cloudinary value the storefront
# needs (delivery URLs are built in src/media/cloudinary.ts, no SDK).
#
# The real value is committed in .env.production so CI and Vercel pick it up
# without duplication; leave this template blank.
VITE_CLOUDINARY_CLOUD_NAME=

# Clerk publishable key. Designed to be public.
VITE_CLERK_PUBLISHABLE_KEY=


# ---- server-side only: never imported by src/ -------------------------------

# Operational data. Provisioned by the Vercel Marketplace Neon integration,
# which injects this into the Vercel project.
DATABASE_URL=

# The live TenancyApiKey for the commerce engine. Belongs in the secrets
# manager, not in a local file, unless you are actively working on the engine
# integration.
COMMERCE_API_KEY=

# Cloudinary UPLOADS. Both are server-side; neither may appear in a VITE_
# variable or in the committed .env.production.
#
# Together with the cloud name these grant full account control, including
# deleting every asset. Store them in the deployment platform's server
# environment and in a password manager — not in this file on a shared machine,
# and never in a committed file.
#
# Nothing reads them yet: the upload endpoint is server-only and not built (see
# the closing note in src/media/cloudinary.ts). Delivery needs only the cloud
# name above.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Transactional email.
RESEND_API_KEY=
TICKET_FROM_EMAIL=

# Worker notifications (workers do not check email).
LINE_CHANNEL_ACCESS_TOKEN=

# Diffusion pipeline. Agency-owned account; cost comes from the RH API.
# Arrives with the Meeting 04 spike.
RUNNINGHUB_API_KEY=

# AI worker model. Mimo is the recommended DEFAULT, not a lock-in: provider
# settings make the model swappable and this is a client decision, not part of
# the dev-team audit.
MIMO_API_KEY=

# Sign-in, server side.
CLERK_SECRET_KEY=

# Shipping labels, from the client's existing USPS account.
USPS_USER_ID=
