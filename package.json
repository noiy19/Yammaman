{
  "name": "yammaman-website",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "description": "Yammaman storefront — React + Vite + TypeScript on the EVA design system with the Yammaman brand kit. Content-as-data (site-content/*.json), multitenant (brand + textile mill).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "tokens:build": "node scripts/gen-eva-tokens.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "content:validate": "node scripts/validate-content.mjs",
    "gate:lane": "node scripts/check-lane.mjs",
    "gate:no-ad-hoc-values": "node scripts/check-no-ad-hoc-values.mjs",
    "gate:contrast": "node scripts/check-contrast.mjs",
    "gate:storybook-contract": "node scripts/check-storybook-contract.mjs",
    "gate": "pnpm run content:validate && pnpm run gate:no-ad-hoc-values && pnpm run gate:contrast && pnpm run gate:storybook-contract && pnpm run typecheck",
    "db:generate": "prisma generate",
    "db:push": "prisma db push"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@prisma/client": "^6.16.1",
    "@storybook/addon-a11y": "^9.1.5",
    "@storybook/addon-docs": "^9.1.5",
    "@storybook/react-vite": "^9.1.5",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prisma": "^6.16.1",
    "storybook": "^9.1.5",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
