{
  "$schema": "../content/schema/tenants.schema.json",
  "version": 1,
  "platform": "muen-collective",
  "note": "Two-level tenant model: platform -> client -> surfaces. yammaman-textile-mill is a surface OF the yammaman client, not a separate client. Isolation is enforced at the data layer by tenantId; this file declares the surfaces and where each one's content lives.",
  "client": {
    "clientId": "yammaman",
    "name": "Yammaman",
    "owner": "Nana Yamasaki"
  },
  "tenants": [
    {
      "tenantId": "yammaman-brand",
      "surface": "brand",
      "name": "Yammaman",
      "basePath": "/",
      "contentDir": "site-content/yammaman-brand",
      "parentTenantId": null,
      "defaultPageId": "home",
      "navOrder": [
        "/",
        "/collection",
        "/story",
        "/faq"
      ],
      "externalLinks": [
        {
          "label": "yamma.jp",
          "href": "https://yamma.jp"
        },
        {
          "label": "harappaaizu.com",
          "href": "https://harappaaizu.com"
        }
      ],
      "signIn": {
        "label": "Sign in",
        "href": "/sign-in"
      },
      "headerCta": {
        "label": "Shop Yammaman",
        "href": "/collection"
      }
    },
    {
      "tenantId": "yammaman-textile-mill",
      "surface": "mill",
      "name": "HARAPPA",
      "basePath": "/mill",
      "contentDir": "site-content/yammaman-textile-mill",
      "parentTenantId": "yammaman-brand",
      "defaultPageId": "home"
    }
  ]
}
